# Rendered by the nginx image entrypoint (envsubst on the variables set in spa.Dockerfile:
# API_UPSTREAM, QR_UPSTREAM, OIDC_AUTHORITY, OIDC_CLIENT_ID). nginx's own $variables are left alone.
#
# Security headers are repeated in every location on purpose: a location with its own add_header
# does not inherit the server-level ones.
# No client IPs in access logs (Law 09-08): method, path without query string, status only.
# (This file is included in the http context, where log_format must live.)
log_format agricoop '$time_iso8601 "$request_method $uri" $status $body_bytes_sent';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    access_log /dev/stdout agricoop;

    # The OIDC provider is a separate origin: token / discovery calls (connect-src) and silent renew
    # (frame-src). Styles: Radix / sonner inject runtime styles.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${OIDC_AUTHORITY}/; frame-src ${OIDC_AUTHORITY}/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime configuration read by src/config.ts (one image for every environment).
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        return 200 'window.__AGRICOOP_CONFIG__ = {"oidcAuthority":"${OIDC_AUTHORITY}","oidcClientId":"${OIDC_CLIENT_ID}"};\n';
    }

    location /api/v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /qr/v1/ {
        proxy_pass ${QR_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # SPA fallback (TanStack Router handles client-side routes such as /v/:token).
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy $csp always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
}
