{
  "name": "@agricoop/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end happy paths (storefront and back office) against a running stack",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@agricoop/config": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
