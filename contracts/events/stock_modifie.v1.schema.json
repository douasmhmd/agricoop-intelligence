{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agricoop.ma/events/stock_modifie.v1.schema.json",
  "title": "StockModifieV1",
  "description": "The stock of a lot changed (one event per mouvement_stock row). Topic agricoop.stock_modifie.v1, key = coop_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "type", "version", "coop_id", "occurred_at", "is_synthetic", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "outbox.event_id; consumers deduplicate on it"
    },
    "type": {
      "const": "stock_modifie"
    },
    "version": {
      "const": 1
    },
    "coop_id": {
      "type": "string",
      "format": "uuid",
      "description": "Tenant; also the Kafka message key"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "outbox.created_at"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "title": "StockModifiePayloadV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mouvement_id",
        "lot_id",
        "produit_id",
        "type_mouvement",
        "quantite",
        "stock_apres",
        "motif",
        "commande_id",
        "date_mouvement"
      ],
      "properties": {
        "mouvement_id": {
          "type": "string",
          "format": "uuid"
        },
        "lot_id": {
          "type": "string",
          "format": "uuid"
        },
        "produit_id": {
          "type": "string",
          "format": "uuid"
        },
        "type_mouvement": {
          "enum": ["entree", "sortie", "perte"]
        },
        "quantite": {
          "type": "integer",
          "minimum": 1
        },
        "stock_apres": {
          "type": "integer",
          "minimum": 0,
          "description": "Stock of the lot after this movement"
        },
        "motif": {
          "enum": ["creation_lot", "commande", "annulation_commande", "perte"]
        },
        "commande_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_mouvement": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
