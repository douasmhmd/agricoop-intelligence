{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agricoop.ma/events/commande_statut_modifie.v1.schema.json",
  "title": "CommandeStatutModifieV1",
  "description": "An order changed status (creee -> payee -> expediee -> livree, or annulee). Topic agricoop.commande_statut_modifie.v1, key = coop_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "type", "version", "coop_id", "occurred_at", "is_synthetic", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "outbox.event_id; consumers deduplicate on it"
    },
    "type": {
      "const": "commande_statut_modifie"
    },
    "version": {
      "const": 1
    },
    "coop_id": {
      "type": "string",
      "format": "uuid",
      "description": "Tenant; also the Kafka message key"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "outbox.created_at"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "title": "CommandeStatutModifiePayloadV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commande_id",
        "client_id",
        "ancien_statut",
        "nouveau_statut",
        "date_changement",
        "montant_total_mad"
      ],
      "properties": {
        "commande_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "ancien_statut": {
          "enum": ["creee", "payee", "expediee", "livree", "annulee"]
        },
        "nouveau_statut": {
          "enum": ["creee", "payee", "expediee", "livree", "annulee"]
        },
        "date_changement": {
          "type": "string",
          "format": "date-time"
        },
        "montant_total_mad": {
          "type": "string",
          "pattern": "^\\d{1,8}(\\.\\d{1,2})?$",
          "description": "Amount in MAD, NUMERIC(10,2) as a string"
        }
      }
    }
  }
}
