{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["eslint.config.mjs", "packages/config/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "api:generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "api:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "api:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "api:generate"]
    },
    "test": {
      "dependsOn": ["^build", "api:generate"],
      "inputs": ["src/**", "test/**", "vitest.config.*", "$TURBO_ROOT$/contracts/**"]
    },
    "openapi:export": {
      "dependsOn": ["build"],
      "outputs": ["openapi.json"]
    },
    "api:generate": {
      "inputs": ["$TURBO_ROOT$/contracts/api/openapi.yaml", "orval.config.ts"],
      "outputs": ["src/api/generated/**"]
    }
  }
}
