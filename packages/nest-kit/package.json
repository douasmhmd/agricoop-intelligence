{
  "name": "@agricoop/nest-kit",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS building blocks shared by apps/api and apps/qr: bootstrap, env, logging redaction, health, metrics, database, OpenAPI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agricoop/db": "workspace:*",
    "@agricoop/shared": "workspace:*",
    "prom-client": "^15.1.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-fastify": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "fastify": "^5.12.8",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agricoop/config": "workspace:*",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-fastify": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/testing": "^11.2.9",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "fastify": "^5.12.8",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
