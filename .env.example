# Copy to .env (git-ignored) for local development. LOCAL VALUES ONLY — never reuse them elsewhere.

# --- Postgres (root docker-compose.yml, port 5433) ---------------------------
POSTGRES_PASSWORD=agricoop_dev
DATABASE_URL=postgres://agricoop:agricoop_dev@localhost:5433/agricoop

# --- Keycloak (docker-compose.apps.yml) ---------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=dev-only-kc-admin
# Password of the demo users in apps/keycloak/realm-agricoop.json:
#   manager.coop01, manager.coop02 (coop_manager), client.demo (customer),
#   revendeur.demo (reseller), admin.saas (saas_admin)
KC_DEMO_PASSWORD=dev-only-Demo-2026
KC_PROVISIONER_SECRET=dev-only-provisioner-secret
KC_API_CLIENT_SECRET=dev-only-api-client-secret

# --- API / QR services (pnpm dev) ----------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
OIDC_ISSUER=http://localhost:8080/realms/agricoop
OIDC_AUDIENCE=agricoop-api
# Mailpit (UI on http://localhost:8025)
SMTP_URL=smtp://localhost:1025
# Derives each cooperative's store key for the CMI-style payment mock (min. 16 chars)
PAYMENT_MOCK_SECRET=dev-only-payment-mock-secret
# Read-only connection to the data plane's gold schema (role from data/bi/04_role_lecture.sql).
# Build the layer with `pnpm db:gold`; without this variable /api/analytics answers 503.
ANALYTICS_DATABASE_URL=postgres://analytics_reader:analytics_dev@localhost:5433/agricoop
# The app images (compose --profile apps) run with NODE_ENV=production, which refuses the value above;
# they use COMPOSE_PAYMENT_MOCK_SECRET (optional, local default in docker-compose.apps.yml).
# COMPOSE_PAYMENT_MOCK_SECRET=

# --- Power BI Embedded (api) -----------------------------------------------------
# All five or none. None = demo mode: the back office's Power BI tab explains what to set.
# Setup (Entra app, workspace, capacity, RLS roles): docs/powerbi-embedding.md. Never commit real values.
# POWERBI_TENANT_ID=<entra-tenant-id>
# POWERBI_CLIENT_ID=<app-registration-client-id>
# POWERBI_CLIENT_SECRET=<client-secret>
# POWERBI_WORKSPACE_ID=<workspace-id>
# key -> report id, or -> {"reportId","page","title"} for one page of a multi-page report:
# POWERBI_REPORTS={"ventes":{"reportId":"<report-id>","page":"<page-name>"},"stocks":{"reportId":"<report-id>","page":"<page-name>"}}
# Optional: POWERBI_API_URL, POWERBI_AUTHORITY_HOST (sovereign clouds), POWERBI_TOKEN_MINUTES (10-60, default 60)

# --- QR service ------------------------------------------------------------------
# Storefront origin encoded in printed labels (${WEB_PUBLIC_URL}/v/<token>)
WEB_PUBLIC_URL=http://localhost:5173
QR_VERIFY_RATE_PER_MIN=30
QR_MAX_SCANS_UNITE=5
QR_LOT_SCAN_FACTOR=2
QR_MAX_VILLES_24H=2

# --- Outbox relay ---------------------------------------------------------------
KAFKA_BROKERS=localhost:19092
TOPIC_PARTITIONS=3
TOPIC_REPLICATION=1

# --- End-to-end tests (apps/e2e) -------------------------------------------------
# E2E_WEB_URL=http://localhost:5173
# E2E_BACKOFFICE_URL=http://localhost:5174
